<?xml version='1.0' encoding='utf-8'?>
<widget id="com.zakaria.hoshinomichibiki" version="1.0.0"
  xmlns="http://www.w3.org/ns/widgets"
  xmlns:cdv="http://cordova.apache.org/ns/1.0">

  <name>星の導き</name>
  <description>Astrology App by Zakaria</description>
  <author email="dev@example.com" href="https://example.com">Zakaria Matar</author>

  <content src="index.html" />
  <access origin="*" />
  <allow-navigation href="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />

  <plugin name="admob-plus-cordova" spec="1.24.0">
    <variable name="APP_ID_ANDROID" value="ca-app-pub-9756015724360400~1341007605" />
  </plugin>

  <preference name="SplashScreenDelay" value="2000" />
  <preference name="AutoHideSplashScreen" value="true" />
  <preference name="FadeSplashScreen" value="true" />
  <preference name="ShowSplashScreenSpinner" value="false" />
  <preference name="Fullscreen" value="false" />
  <preference name="BackgroundColor" value="0xff030305" />

  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <allow-intent href="market:*" />

    <icon src="res/icon.png" />
    <icon density="mdpi"    src="res/icon-48.png" />
    <icon density="hdpi"    src="res/icon-72.png" />
    <icon density="xhdpi"   src="res/icon-96.png" />
    <icon density="xxhdpi"  src="res/icon-144.png" />
    <icon density="xxxhdpi" src="res/icon-192.png" />

    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#000000" />
    <preference name="AndroidWindowSplashScreenFadeOutDuration" value="500" />
  </platform>

</widget>
